// Cells to refine; name of cell set
set c1;

// Coordinate system for refinement
coordinateSystem global;

// Global coordinate system coefficients
globalCoeffs
{
    tan1 (1 0 0);  // Refine further in the x-axis to achieve 8 divisions
    tan2 (0 1 0);  // Refine in the y-axis
}

// Refine in x (tan1), y (tan2), and the normal direction (z-axis)
directions
(
 //    tan1  // 4x in x-direction
    //    tan2  // 2x in y-direction
    normal  // 2x in z-direction
);

// Hex topology and settings
useHexTopology true;
geometricCut  false;
writeMesh     false;

